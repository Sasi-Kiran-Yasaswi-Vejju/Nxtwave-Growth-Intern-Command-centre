# ==========================================
# NxtWave AI Workshop Growth Engine - Env Config
# ==========================================

# Port for Backend API
PORT=5000
NODE_ENV=development

# Frontend API Base URL
VITE_API_URL=http://localhost:5000/api

# OpenAI API Key (Optional - application includes smart offline generator fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Supabase / PostgreSQL Configuration (Optional - in-memory mock/demo store enabled by default)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
DATABASE_URL=postgresql://postgres:password@localhost:5432/nxtwave_growth

# Simulation & Demo Settings
DEMO_MODE=true
ENABLE_SIMULATED_DATA=true
